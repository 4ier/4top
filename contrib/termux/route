#!/data/data/com.termux/files/usr/bin/sh
# ssh ProxyCommand for machines at home.
#
#   ProxyCommand ~/.ssh/route %p LAN_ADDRESS TAILNET_ADDRESS
#   ProxyCommand ~/.ssh/route %p LAN_ADDRESS via:JUMP_ALIAS    (not on the tailnet)
#
# Prefer tailscaled whenever it runs: at home it finds the LAN path by itself, away it
# finds a direct path, so nothing has to guess where this device is. (A guess from a
# 192.168.0.x address misfires on every other network that uses the same range.)
# Checking the local SOCKS port is instant. Without tailscaled, use the LAN address,
# so home use never depends on it.
socks=${TAILSCALE_SOCKS:-127.0.0.1:1055}
port=$1 lan=$2 remote=$3
# If the tailnet path fails before a connection is made (the host or the jump host is
# off), fall back to the LAN address: at home a sleeping jump host must not hide the
# machine behind it. Nothing has been sent at that point, so the retry is invisible.
#
# The timeout guards only the attempt. netcat's -w is also an *idle* timeout: on the
# connection itself it closed every session that sat quiet for five seconds, so
# reachability is probed with -z -w and the connection is made without it.
if nc -z "${socks%:*}" "${socks##*:}" 2>/dev/null; then
    case $remote in
        via:*) ssh -o ConnectTimeout=5 -W "$lan:$port" "${remote#via:}" 2>/dev/null && exit 0 ;;
        *) nc -z -w 5 -X 5 -x "$socks" "$remote" "$port" 2>/dev/null &&
               exec nc -X 5 -x "$socks" "$remote" "$port" ;;
    esac
fi
exec nc "$lan" "$port"
