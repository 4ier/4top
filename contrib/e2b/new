#!/bin/sh
# Create a 4top sandbox and print the host entry for it.
#
# The sandbox is tagged fourtop=1, so it is never confused with the project's other
# sandboxes; it pauses after ten idle minutes; it accepts this machine's ssh key; and
# its agents are signed in with this machine's own credentials: the Claude token
# from `claude setup-token` and Codex's auth.json. The [agents] entries of this
# machine's 4top configuration are copied too, so a permission mode carries over.
#
#   contrib/e2b/new NAME          needs curl, python3 and the e2b CLI
set -eu
name=${1:?usage: contrib/e2b/new NAME}
key=${E2B_API_KEY:-$(python3 -c 'import json,os
print(json.load(open(os.path.expanduser("~/.e2b/config.json")))["projectApiKey"])')}
export E2B_API_KEY="$key"

id=$(curl -fsS -X POST https://api.e2b.dev/sandboxes -H "X-API-KEY: $key" \
    -H 'Content-Type: application/json' \
    -d "{\"templateID\":\"4top\",\"timeout\":600,\"autoPause\":true,
         \"metadata\":{\"fourtop\":\"1\",\"fourtop_name\":\"$name\"}}" |
    python3 -c 'import json,sys; print(json.load(sys.stdin)["sandboxID"])')

# Write stdin into the sandbox as file $1, private to its user. base64 keeps any
# content intact through the two shells between here and there.
put() {
    e2b sandbox exec "$id" -- sh -c "umask 077; mkdir -p \"\$(dirname $1)\"; echo $(base64 | tr -d '\n') | base64 -d > $1"
}

{ cat ~/.ssh/id_ed25519.pub 2>/dev/null || cat ~/.ssh/id_rsa.pub; } | put '~/.ssh/authorized_keys'
token=~/.config/claude-code/oauth-token
if [ -r "$token" ]; then
    printf 'CLAUDE_CODE_OAUTH_TOKEN=%s\n' "$(cat "$token")" | put '~/.ssh/environment'
    echo '{"hasCompletedOnboarding": true}' | put '~/.claude.json'
fi
[ -r ~/.codex/auth.json ] && put '~/.codex/auth.json' < ~/.codex/auth.json
python3 - <<'EOF' | put '~/.config/4top/config.toml'
import os, tomllib
path = os.path.expanduser(os.environ.get("XDG_CONFIG_HOME", "~/.config")) + "/4top/config.toml"
try:
    agents = tomllib.load(open(path, "rb")).get("agents", {})
except OSError:
    agents = {}
for agent, options in agents.items():
    if options.get("args"):
        print(f"[agents.{agent}]\nargs = {options['args']!r}".replace("'", '"'))
EOF

printf '[hosts.%s]\ne2b = "%s"\n' "$name" "$id"
